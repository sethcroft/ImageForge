<Window x:Class="ImageForge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ImageForge — Windows Image Workshop" Width="1180" Height="850" MinWidth="950" MinHeight="700" Closing="Window_Closing">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="IMAGEFORGE" FontSize="13" FontWeight="Bold" Foreground="#5EE8B3"/><TextBlock Text="Your Windows. Your build." FontSize="30" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock Text="An offline image workshop · Preview 0.1" Foreground="#9CAEC5"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="MountBadge" Text="NO IMAGE MOUNTED" Foreground="#5EE8B3" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="QueueBadge" Text="0 changes queued" Foreground="#9CAEC5" HorizontalAlignment="Right" Margin="0,6,0,0"/></StackPanel></Grid>
    <Border Grid.Row="1" Background="#192B2C" CornerRadius="8" Padding="14" Margin="0,0,0,20"><TextBlock Text="WORKFLOW   01  Select an image    →    02  Queue changes    →    03  Apply &amp; save" Foreground="#B7DACD"/></Border>
    <TabControl Grid.Row="2" x:Name="WorkspaceTabs">
      <TabItem Header="01  Image"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,24,18,8">
        <TextBlock Text="Start with a Windows image" Style="{StaticResource Section}"/><TextBlock Text="Choose a writable WIM file. ESD editions can be inspected; export them to WIM with DISM before mounting. For an ISO, extract its sources/install.wim first." Style="{StaticResource Muted}"/>
        <TextBlock Text="Image source"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseImage_Click" Margin="10,6,0,14"/><TextBox x:Name="ImagePathBox"/></DockPanel>
        <WrapPanel><Button Content="Read editions" Click="ReadEditions_Click"/></WrapPanel>
        <TextBlock Text="Edition"/><ComboBox x:Name="EditionBox" DisplayMemberPath="Name"/>
        <TextBlock Text="Mount directory (a new or empty local folder)"/><DockPanel><Button DockPanel.Dock="Right" Content="Choose…" Click="BrowseMount_Click" Margin="10,6,0,14"/><TextBox x:Name="MountPathBox"/></DockPanel>
        <WrapPanel><Button Content="Mount selected edition" Background="#12674F" Click="Mount_Click"/><Button Content="Reconnect owned mount" Click="Reconnect_Click"/></WrapPanel>
        <TextBlock Text="Reconnect restores a mount created by ImageForge after restarting the app. Existing mounts made by other tools are left alone." Style="{StaticResource Muted}"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="02  Integrate"><StackPanel Margin="18,24,18,8">
        <TextBlock Text="Bring the essentials" Style="{StaticResource Section}"/><TextBlock Text="Queue signed INF drivers and locally downloaded CAB/MSU update packages. Files are applied in queue order; add prerequisites before dependent updates." Style="{StaticResource Muted}"/>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="Hardware drivers" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Add an individual INF or search a driver folder recursively." Foreground="#9CAEC5" Margin="0,0,0,16"/><WrapPanel><Button Content="Add INF files…" Click="AddDrivers_Click"/><Button Content="Add driver folder…" Click="AddDriverFolder_Click"/></WrapPanel></StackPanel></Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="Windows updates" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Use update packages matching the target Windows version and architecture." Foreground="#9CAEC5" Margin="0,0,0,16"/><Button Content="Add update packages…" HorizontalAlignment="Left" Click="AddPackages_Click"/></StackPanel></Border>
      </StackPanel></TabItem>
      <TabItem Header="03  Features"><Grid Margin="18,24,18,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Choose what ships" Style="{StaticResource Section}"/><TextBlock Text="Read optional features from the mounted image. Disabling a feature retains its payload. DISM validates dependencies when changes are applied." Style="{StaticResource Muted}"/></StackPanel>
        <WrapPanel Grid.Row="1"><Button Content="Refresh image features" Click="RefreshFeatures_Click"/></WrapPanel>
        <ListView Grid.Row="2" x:Name="FeatureList" SelectionMode="Extended"><ListView.View><GridView><GridViewColumn Header="Feature name" Width="560" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Current state" Width="210" DisplayMemberBinding="{Binding State}"/></GridView></ListView.View></ListView>
        <WrapPanel Grid.Row="3"><Button Content="Queue enable" Click="EnableFeatures_Click"/><Button Content="Queue disable" Click="DisableFeatures_Click"/></WrapPanel>
      </Grid></TabItem>
      <TabItem Header="04  Unattended"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,24,18,8">
        <TextBlock Text="A consistent first boot" Style="{StaticResource Section}"/><TextBlock Text="Generate an amd64 Windows answer file with machine identity, language, and time zone. Export to Autounattend.xml at the root of your installation USB. This does not inject the file into the mounted image." Style="{StaticResource Muted}"/>
        <TextBlock Text="Computer name (1–15 letters, digits or hyphens; not all digits)"/><TextBox x:Name="ComputerNameBox" Text="WORKSTATION" MaxLength="15"/>
        <TextBlock Text="Windows locale"/><TextBox x:Name="LocaleBox" Text="en-US"/>
        <TextBlock Text="Windows time zone ID"/><TextBox x:Name="TimeZoneBox" Text="UTC"/>
        <Button Content="Export Autounattend.xml…" Background="#12674F" HorizontalAlignment="Left" Click="ExportUnattend_Click"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="05  Apply"><Grid Margin="18,24,18,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Review your build" Style="{StaticResource Section}"/><TextBlock Text="Apply executes changes in order and stops on the first error. Successful steps leave the queue. Save &amp; unmount writes all mounted changes back to the WIM." Style="{StaticResource Muted}"/></StackPanel>
        <WrapPanel Grid.Row="1"><Button Content="Load preset…" Click="LoadPreset_Click"/><Button Content="Save preset…" Click="SavePreset_Click"/><Button Content="Remove selected" Click="RemoveSteps_Click"/><Button Content="Move up" Click="MoveUp_Click"/><Button Content="Move down" Click="MoveDown_Click"/></WrapPanel>
        <ListView Grid.Row="2" x:Name="PlanList" SelectionMode="Extended"><ListView.View><GridView><GridViewColumn Header="Operation" Width="180" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="Target" Width="640" DisplayMemberBinding="{Binding Value}"/></GridView></ListView.View></ListView>
        <WrapPanel Grid.Row="3"><Button Content="Apply queued changes" Background="#12674F" Click="Apply_Click"/><Button Content="Save &amp; unmount" Click="Commit_Click"/><Button Content="Discard &amp; unmount" Background="#703B40" Click="Discard_Click"/></WrapPanel>
        <TextBlock Grid.Row="4" Text="Discard drops every unsaved change in the mount, including earlier successful operations. Presets store paths and queued operations, not image files." Foreground="#9CAEC5" FontSize="12"/>
      </Grid></TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,18,0,8"><Button DockPanel.Dock="Right" Content="Export log…" Padding="12,5" Margin="8,0,0,0" Click="ExportLog_Click"/><ProgressBar x:Name="BusyProgress" DockPanel.Dock="Right" Width="100" Height="5" Margin="12,0" Visibility="Collapsed" IsIndeterminate="True"/><TextBlock x:Name="StatusText" Text="Ready. Choose an image to begin." Foreground="#9CAEC5" VerticalAlignment="Center"/></DockPanel>
    <TextBox Grid.Row="4" x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Margin="0"/>
  </Grid>
</Window>

<Window x:Class="ImageForge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ImageForge" Width="1360" Height="850" MinWidth="1120" MinHeight="720" Closing="Window_Closing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E7E7E7" BorderBrush="#D9D9D9" BorderThickness="0,0,0,1"><DockPanel Margin="10,0"><TextBlock Text="☰" Margin="6,0,20,0" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="ImageForge · Preview 0.4" Foreground="#777777" FontSize="11" VerticalAlignment="Center"/><Menu x:Name="TopMenu"><MenuItem Header="Image"><MenuItem Header="Add file…" Click="AddImage_Click"/><MenuItem Header="Add directory…" Click="AddDirectory_Click"/><MenuItem Header="Import ISO…" Click="ImportIso_Click"/><MenuItem Header="Download Windows…" Click="ShowDownloads_Click"/><Separator/><MenuItem Header="Load selected edition" Click="Mount_Click"/><MenuItem Header="Save and unmount" Click="Commit_Click"/><MenuItem Header="Unmount and discard…" Click="Discard_Click"/></MenuItem><MenuItem Header="Preset"><MenuItem Header="Import file…" Click="LoadPreset_Click"/><MenuItem Header="Save preset…" Click="SavePreset_Click"/></MenuItem><MenuItem Header="Tools"><MenuItem Header="Image and ISO tools" Click="ShowTools_Click"/><MenuItem Header="Export / convert…" Click="ExportEdition_Click"/><MenuItem Header="Split WIM…" Click="SplitImage_Click"/><MenuItem Header="Reconnect owned mount" Click="Reconnect_Click"/><MenuItem Header="Host refresh…" Click="ShowRefresh_Click"/></MenuItem><MenuItem Header="Help"><MenuItem Header="Compatibility" Click="ShowCompatibility_Click"/><MenuItem Header="Public documentation" Click="OpenDocumentation_Click"/><MenuItem Header="Diagnostics folder" Click="OpenDiagnostics_Click"/><MenuItem Header="Project on GitHub" Click="OpenGitHub_Click"/></MenuItem></Menu></DockPanel></Border>
  <Border Grid.Row="1" Background="#F6F6F6" BorderBrush="#DADADA" BorderThickness="0,0,0,1"><StackPanel x:Name="CommandRibbon"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="ImageCommands" Orientation="Horizontal" Margin="10,7"><Button Click="AddMenu_Click" AutomationProperties.Name="Add image source"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Add ▾"/></StackPanel></Button><Button Click="NewSession_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="New session"/></StackPanel></Button><Separator Width="1" Margin="6,0,12,0"/><Button x:Name="MountImageButton" Click="Mount_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↳" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Load"/></StackPanel></Button><Button x:Name="SaveImageButton" Click="Commit_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Save"/></StackPanel></Button><Button x:Name="DiscardImageButton" Click="Discard_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⏏" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Unmount"/></StackPanel></Button><Separator Width="1" Margin="6,0,12,0"/><Button Click="CreateIsoPage_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Create ISO"/></StackPanel></Button><Button Click="ExportEdition_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↗" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Export"/></StackPanel></Button><Button Click="Reconnect_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Reconnect"/></StackPanel></Button><Separator Width="1" Margin="6,0,12,0"/><Button Click="ForgetSource_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌫" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Forget"/></StackPanel></Button></StackPanel></ScrollViewer><WrapPanel x:Name="PageCommands" Margin="10,7" Visibility="Collapsed"><Button x:Name="ContextAddButton" Click="ContextAdd_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Add"/></StackPanel></Button><Button x:Name="ContextSecondaryButton" Content="Refresh" Click="ContextSecondary_Click"/><Separator Width="1" Margin="6,0,12,0"/><Button Click="BackToImage_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Image"/></StackPanel></Button><Button Click="ReviewQueue_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Review pending changes"/></StackPanel></Button></WrapPanel><TextBlock x:Name="PageHint" Text="Use an existing image below, or add a file, directory, or Windows download." TextAlignment="Center" FontSize="11" Foreground="#777777" Margin="14,0,14,9"/></StackPanel></Border>
  <Grid Grid.Row="2" x:Name="WorkspaceBody" Margin="14,14,14,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PresetColumn" Width="310" MinWidth="250"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,12,0"><StackPanel DockPanel.Dock="Bottom" Margin="6,12"><TextBlock x:Name="MountBadge" Text="No image loaded" Foreground="#777777" FontSize="10"/><TextBlock x:Name="QueueBadge" Text="0 changes queued" Foreground="#777777" FontSize="10" Margin="0,5,0,0"/></StackPanel><Border Background="#F7F7F7" CornerRadius="7" Padding="5" VerticalAlignment="Top"><ScrollViewer VerticalScrollBarVisibility="Auto"><ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" SelectionChanged="Navigation_Changed">
    <ListBoxItem Content="Start" Style="{StaticResource NavigationHeading}"/>
    <ListBoxItem Tag="0"><DockPanel><TextBlock x:Name="SideImageCount" DockPanel.Dock="Right" Text="0" Foreground="#888888"/><TextBlock Text="▣   Image"/></DockPanel></ListBoxItem>
    <ListBoxItem x:Name="IntegrateHeading" Content="Integrate" Style="{StaticResource NavigationHeading}" Visibility="Collapsed"/>
    <ListBoxItem Tag="2" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Updates"/></StackPanel></ListBoxItem>
    <ListBoxItem Tag="1" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Drivers"/></StackPanel></ListBoxItem>
    <ListBoxItem Tag="10" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Registry"/></StackPanel></ListBoxItem>
    <ListBoxItem Tag="11" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Post-Setup"/></StackPanel></ListBoxItem>
    <ListBoxItem x:Name="RemoveHeading" Content="Remove" Style="{StaticResource NavigationHeading}" Visibility="Collapsed"/>
    <ListBoxItem Tag="12" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Components"/></StackPanel></ListBoxItem>
    <ListBoxItem x:Name="ConfigureHeading" Content="Configure" Style="{StaticResource NavigationHeading}" Visibility="Collapsed"/>
    <ListBoxItem Tag="3" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="☑" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Features"/></StackPanel></ListBoxItem>
    <ListBoxItem Tag="13" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="▥" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Settings"/></StackPanel></ListBoxItem>
    <ListBoxItem Tag="14" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Scheduled Tasks"/></StackPanel></ListBoxItem>
    <ListBoxItem Tag="4" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="▧" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Unattended"/></StackPanel></ListBoxItem>
    <ListBoxItem x:Name="FinishHeading" Content="Finish" Style="{StaticResource NavigationHeading}" Visibility="Collapsed"/>
    <ListBoxItem Tag="6" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="▶" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Apply"/></StackPanel></ListBoxItem>
   </ListBox></ScrollViewer></Border></DockPanel>
   <TabControl Grid.Column="1" x:Name="WorkspaceTabs" Margin="0,0,12,0"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,5"><TextBlock x:Name="ImageCountBadge" DockPanel.Dock="Right" Text="0 editions" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/><WrapPanel><TextBlock Text="Images" VerticalAlignment="Center" Margin="7,0,14,0"/><Button Click="AddImage_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="File"/></StackPanel></Button><Button Click="AddDirectory_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▰" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Directory"/></StackPanel></Button><Button Click="ShowDownloads_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↓" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Download"/></StackPanel></Button></WrapPanel></DockPanel>
     <Border Grid.Row="1" Background="#FAFAFA" CornerRadius="6" Padding="6" Margin="0,0,0,12"><DockPanel><ComboBox x:Name="SourceKindFilter" Width="100" SelectedIndex="0" SelectionChanged="SourceKind_Changed" Margin="0,0,8,0" Padding="4,2"><ComboBoxItem Content="All"/><ComboBoxItem Content="Read-only"/><ComboBoxItem Content="Other"/></ComboBox><TextBlock Text="⌕" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="ImageFilterBox" TextChanged="ImageFilter_Changed" ToolTip="Filter images by edition, source or format" Margin="0" Padding="4,3" BorderThickness="0"/></DockPanel></Border>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#FAFAFA" CornerRadius="6" Margin="0,0,0,12" Padding="8"><StackPanel><TextBlock Text="⌄  Deployed" Foreground="#777777" FontSize="11" Margin="0,0,0,4"/><WrapPanel><Button Click="SelectLive_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="This PC · Windows"/></StackPanel></Button><Button Click="SelectDeployed_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▰" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Add Windows drive…"/></StackPanel></Button><Button Click="ShowRefresh_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Host refresh"/></StackPanel></Button></WrapPanel><TextBlock x:Name="TargetCaption" Text="Choose an image or deployed Windows installation." FontSize="10" Foreground="#888888"/></StackPanel></Border><Grid Grid.Row="1"><ListView Background="Transparent" x:Name="ImageList" MouseDoubleClick="Image_DoubleClick" SelectionChanged="ImageSelection_Changed"><ListView.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" Background="#FAFAFA" BorderBrush="#E2E2E2" BorderThickness="0,0,0,1"><Expander.Header><TextBlock Text="{Binding Name}" Foreground="#666666" Margin="3,4" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Expander.Header><ItemsPresenter Margin="12,0,0,0"/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ListView.GroupStyle><ListView.View><GridView><GridViewColumn Header="Image / Edition" Width="245" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Index" Width="48" DisplayMemberBinding="{Binding Index}"/><GridViewColumn Header="Type" Width="55" DisplayMemberBinding="{Binding Format}"/><GridViewColumn Header="Size (MB)" Width="80" DisplayMemberBinding="{Binding SizeMb}"/><GridViewColumn Header="Status" Width="120"><GridViewColumn.CellTemplate><DataTemplate><Grid Height="18"><TextBlock x:Name="RowNormalStatus" Text="{Binding Status}" VerticalAlignment="Center"/><Grid x:Name="RowProgress" Visibility="Collapsed"><ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding Indeterminate}" Foreground="#1685AA" Background="#E7EDF1"/><TextBlock Text="{Binding ProgressLabel}" FontSize="10" Foreground="#203E4D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="RowNormalStatus" Property="Visibility" Value="Collapsed"/><Setter TargetName="RowProgress" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Last change" Width="130" DisplayMemberBinding="{Binding Modified}"/></GridView></ListView.View></ListView><StackPanel x:Name="ImageEmptyState" VerticalAlignment="Top" Margin="0,38,0,0" IsHitTestVisible="False"><Border Background="#F8F8F8" CornerRadius="6" Padding="10" Margin="0,0,0,12"><StackPanel><TextBlock Text="⌄  Read-only" Foreground="#777777"/><TextBlock Text="Packed ESD and split SWM sources appear here." Foreground="#999999" FontSize="11" Margin="16,7,0,0"/></StackPanel></Border><Border Background="#F8F8F8" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="⌄  Other" Foreground="#777777"/><TextBlock Text="Add an image file or directory to see its editions." Foreground="#999999" FontSize="11" Margin="16,7,0,0"/></StackPanel></Border></StackPanel></Grid></Grid>
     <Expander Grid.Row="3" Header="Selected image · Source and mount options" Margin="0,8,0,0" IsExpanded="False"><Border Style="{StaticResource Card}" Padding="10"><StackPanel><TextBlock Text="SELECTED IMAGE" FontSize="10" Foreground="#8C98A4" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="Read" Click="ReadEditions_Click" Margin="8,5,0,12"/><TextBox x:Name="ImagePathBox"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Edition" FontSize="11" Foreground="#74808D"/><ComboBox x:Name="EditionBox" DisplayMemberPath="Name"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Mount directory" FontSize="11" Foreground="#74808D"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseMount_Click" Margin="6,5,0,12"/><TextBox x:Name="MountPathBox"/></DockPanel></StackPanel></Grid><WrapPanel><Button Content="Load selected image" Style="{StaticResource PrimaryButton}" Click="Mount_Click"/><Button Content="Forget source" Click="ForgetSource_Click"/><Button Content="Image tools →" Click="ShowTools_Click"/></WrapPanel></StackPanel></Border></Expander>
    </Grid></TabItem>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><TextBlock Text="Driver queue" Margin="7,0,14,0" VerticalAlignment="Center"/><Button Click="AddDrivers_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="File"/></StackPanel></Button><Button Click="AddDriverFolder_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▰" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Directory"/></StackPanel></Button></WrapPanel><Border Grid.Row="1" Background="#FAFAFA" CornerRadius="6"><ListView x:Name="DriverQueue"><ListView.View><GridView><GridViewColumn Header="Queued file / Directory" Width="520" DisplayMemberBinding="{Binding Value}"/><GridViewColumn Header="Operation" Width="140" DisplayMemberBinding="{Binding Kind}"/></GridView></ListView.View></ListView></Border><TextBlock Grid.Row="2" Text="Add INF files or a directory. Review and process the queue in Apply. Driver integration is offline-only." Foreground="#888888" FontSize="11" Margin="7,10"/></Grid></TabItem>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><TextBlock Text="Updates" Margin="7,0,14,0" VerticalAlignment="Center"/><Button Click="AddPackages_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="File"/></StackPanel></Button></WrapPanel><Border Grid.Row="1" Background="#FAFAFA" CornerRadius="6"><ListView x:Name="UpdateQueue"><ListView.View><GridView><GridViewColumn Header="Queued file / Directory" Width="520" DisplayMemberBinding="{Binding Value}"/><GridViewColumn Header="Operation" Width="140" DisplayMemberBinding="{Binding Kind}"/></GridView></ListView.View></ListView></Border><TextBlock Grid.Row="2" Text="Add applicable CAB/MSU packages in prerequisite order. Downloads and automatic sorting are planned." Foreground="#888888" FontSize="11" Margin="7,10"/></Grid></TabItem>
    <TabItem><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Optional features" Style="{StaticResource Section}"/><TextBlock Text="Read the selected Windows target and queue feature changes. Disable retains the payload; proprietary component removal is not included." Style="{StaticResource Muted}"/></StackPanel><Button Grid.Row="1" Content="Refresh image features" HorizontalAlignment="Left" Click="RefreshFeatures_Click"/><ListView Grid.Row="2" x:Name="FeatureList" SelectionMode="Extended" Margin="0,8"><ListView.View><GridView><GridViewColumn Header="Feature" Width="390" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="State" Width="180" DisplayMemberBinding="{Binding State}"/></GridView></ListView.View></ListView><WrapPanel Grid.Row="3"><Button Content="Queue enable" Click="EnableFeatures_Click"/><Button Content="Queue disable" Click="DisableFeatures_Click"/></WrapPanel></Grid></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock Text="Unattended setup" Style="{StaticResource Section}"/><TextBlock Text="Export a partial amd64 answer file for the root of your installation media. Other Windows Setup questions remain interactive." Style="{StaticResource Muted}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Computer name"/><TextBox x:Name="ComputerNameBox" Text="WORKSTATION" MaxLength="15"/><TextBlock Text="Windows locale"/><TextBox x:Name="LocaleBox" Text="en-US"/><TextBlock Text="Windows time zone ID"/><TextBox x:Name="TimeZoneBox" Text="UTC"/><Button Content="Export Autounattend.xml…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="ExportUnattend_Click"/></StackPanel></Border><TextBlock Text="Validate with Windows System Image Manager against your target image. Language packs must already be installed." Style="{StaticResource Muted}"/></StackPanel></ScrollViewer></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock Text="Image &amp; ISO tools" Style="{StaticResource Section}"/><TextBlock Text="Export, convert, split, and rebuild installation media. Choose new output paths; existing files are preserved." Style="{StaticResource Muted}"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Export, convert &amp; split" FontWeight="SemiBold" FontSize="17"/><CheckBox x:Name="ExportAllCheck" Content="Include all editions when exporting or converting" IsChecked="True" Margin="0,10"/><TextBlock Text="Select a source and edition in Image. ESD/SWM sources are prepared automatically when loaded. Export to WIM/ESD, or join a complete SWM set by exporting it. Split WIM preserves all source editions." Style="{StaticResource Muted}" Margin="0,8,0,14"/><WrapPanel><Button Content="Export / join / convert…" Click="ExportEdition_Click"/><TextBox x:Name="SplitSizeBox" Text="3800" Width="72" Margin="0,0,5,7"/><TextBlock Text="MB" VerticalAlignment="Center" Margin="0,0,12,7"/><Button Content="Split WIM…" Click="SplitImage_Click"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows installation media" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Convert a selected WIM/ESD/SWM to an ISO using matching Windows setup media as a template. Setup and boot files are required; an install image alone cannot form bootable media." Foreground="#74808D" Margin="0,8,0,12"/><Button Content="Convert image to ISO…" HorizontalAlignment="Left" Click="ConvertImageToIso_Click"/><TextBlock Text="Import an ISO to a new folder, service sources/install.wim, save and unmount, then create an ISO from the complete media folder." Style="{StaticResource Muted}" Margin="0,8,0,14"/><TextBlock Text="Extracted media folder"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseMedia_Click" Margin="8,5,0,12"/><TextBox x:Name="MediaFolderBox"/></DockPanel><TextBlock Text="Windows ADK oscdimg.exe"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseOscdimg_Click" Margin="8,5,0,12"/><TextBox x:Name="OscdimgPathBox"/></DockPanel><TextBlock Text="ISO volume label"/><TextBox x:Name="IsoLabelBox" Text="IMAGEFORGE" MaxLength="32"/><WrapPanel><Button Content="Import ISO…" Click="ImportIso_Click"/><Button Content="Create bootable ISO…" Style="{StaticResource PrimaryButton}" Click="CreateIso_Click"/></WrapPanel><TextBlock Text="Requires BIOS + UEFI boot files, setup.exe, boot.wim, and an install image. oscdimg is supplied separately by Microsoft's Windows ADK." FontSize="11" Foreground="#74808D"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Edition management" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Remove unwanted editions from an unmounted WIM, or queue an eligible edition upgrade on a loaded offline Windows image. Conversion does not activate Windows or grant a license. Delete removes edition entries; export the result to reclaim unused resources." Foreground="#74808D" Margin="0,8,0,12"/><WrapPanel><Button Content="Delete selected edition…" Click="DeleteEdition_Click"/><Button Content="Read eligible upgrades" Click="ReadTargetEditions_Click"/></WrapPanel><ComboBox x:Name="TargetEditionBox"/><Button Content="Queue edition upgrade" HorizontalAlignment="Left" Click="QueueEdition_Click"/><TextBlock Text="Servicing engine" FontWeight="SemiBold" FontSize="17" Margin="0,16,0,0"/><TextBlock Text="Leave empty for Windows' built-in DISM, or select an installed ADK dism.exe compatible with the target image. ADK tools are not installed by ImageForge." Style="{StaticResource Muted}" Margin="0,8,0,14"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseDism_Click" Margin="8,5,0,12"/><TextBox x:Name="DismPathBox"/></DockPanel></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Apply changes" Style="{StaticResource Section}"/><TextBlock Text="Review the queue before applying. Processing stops on the first failure. Image-file changes require save/discard; deployed/live changes are written immediately." Style="{StaticResource Muted}"/></StackPanel><WrapPanel Grid.Row="1"><Button Content="Remove selected" Click="RemoveSteps_Click"/><Button Content="Move up" Click="MoveUp_Click"/><Button Content="Move down" Click="MoveDown_Click"/></WrapPanel><ListView Grid.Row="2" x:Name="PlanList" SelectionMode="Extended" Margin="0,8"><ListView.View><GridView><GridViewColumn Header="Operation" Width="155" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="Target" Width="420" DisplayMemberBinding="{Binding Value}"/></GridView></ListView.View></ListView><WrapPanel Grid.Row="3"><Button Content="Apply queued changes" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/><Button x:Name="SharedSaveButton" Content="Save &amp; unmount" Click="Commit_Click"/><Button x:Name="SharedDiscardButton" Content="Discard &amp; unmount" Click="Discard_Click"/></WrapPanel><TextBlock Grid.Row="4" Text="Discard applies to mounted image files only. Live/deployed changes cannot be discarded. Presets currently describe image-file projects." FontSize="11" Foreground="#74808D"/></Grid></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock Text="Windows compatibility" Style="{StaticResource Section}"/><TextBlock Text="Host requirements and target-image compatibility are different. A listed Windows family is not a certification of every image, update, or driver." Style="{StaticResource Muted}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Host computer" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Windows 11 x64 is the development target. Windows 10 x64 is a compatibility candidate with servicing-engine and .NET support limitations. Administrator access is required." Margin="0,10"/><TextBlock Text="The initial preview was successfully tested by you; the exact Windows version and build were not supplied. No build-specific certification is claimed." Foreground="#74808D"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Formats &amp; target images" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="WIM/ESD: inspect and convert selected or all editions. SWM: split and rejoin complete sets by exporting. ISO: download with SHA-256 verification, import and create using ADK oscdimg. VHD/VHDX: inspect and mount using DISM; Windows validation is still required." Margin="0,10"/><TextBlock Text="Windows 11 images are the primary target. Windows 10 and Windows Server images require matching Microsoft tool support and remain unverified. Windows 7/8/8.1 and ARM64 hosts are outside the preview scope. Live Windows supports applicable update packages and optional features. Offline drivers and eligible edition upgrades are separate operations." Foreground="#74808D"/></StackPanel></Border><Button Content="Full compatibility documentation →" HorizontalAlignment="Left" Click="OpenDocumentation_Click"/></StackPanel></ScrollViewer></TabItem>

    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock Text="Download Windows" Style="{StaticResource Section}"/><TextBlock Text="Generate a link on Microsoft's official page, then paste its direct download URL and SHA-256 hash here. Links can expire; the hash must match the exact release, language and architecture." Style="{StaticResource Muted}"/><WrapPanel><Button Content="Official Windows 11 downloads ↗" Click="OpenWindows11_Click"/><Button Content="Official Windows 10 downloads ↗" Click="OpenWindows10_Click"/></WrapPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Microsoft direct download link"/><TextBox x:Name="DownloadUrlBox"/><TextBlock Text="Expected SHA-256 from Microsoft"/><TextBox x:Name="DownloadHashBox"/><Button Content="Download &amp; verify…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="DownloadWindows_Click"/><TextBlock Text="Choose a new ISO or ESD file. ImageForge verifies SHA-256 before publishing the completed file. Cancelled, failed and mismatched downloads are removed." Foreground="#74808D" Margin="0,10,0,0"/></StackPanel></Border><TextBlock Text="This is a direct-link downloader, not an automatic Microsoft version catalogue. Other download hosts are not accepted." Style="{StaticResource Muted}"/></StackPanel></ScrollViewer></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock Text="Host refresh wizard" Style="{StaticResource Section}"/><TextBlock Text="Check a Windows upgrade and open Microsoft's interactive setup. Use original, matching installation media. Windows Setup determines whether applications, settings and personal files can be kept." Style="{StaticResource Muted}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="1. Choose original Microsoft media" FontWeight="SemiBold" FontSize="16"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseRefreshMedia_Click" Margin="8,5,0,12"/><TextBox x:Name="RefreshMediaBox" TextChanged="RefreshMedia_Changed"/></DockPanel><CheckBox x:Name="OriginalMediaCheck" Checked="RefreshMedia_Changed" Unchecked="RefreshMedia_Changed" Margin="0,5,0,18"><TextBlock Text="I am using unmodified Microsoft media matching this PC's architecture and system UI language." TextWrapping="Wrap"/></CheckBox><TextBlock Text="2. Check compatibility" FontWeight="SemiBold" FontSize="16"/><Button Content="Run Windows Setup compatibility scan" HorizontalAlignment="Left" Click="ScanRefresh_Click" Margin="0,12,0,12"/><TextBlock x:Name="RefreshResultText" Text="No compatibility scan has been completed." Foreground="#74808D" Margin="0,0,0,22"/><TextBlock Text="3. Review the upgrade in Windows Setup" FontWeight="SemiBold" FontSize="16"/><Button x:Name="HostLaunchButton" Content="Open interactive Windows Setup…" IsEnabled="False" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="LaunchRefresh_Click" Margin="0,12,0,12"/><TextBlock Text="You review license terms and preservation choices in Windows Setup. ImageForge does not accept licenses, bypass hardware checks, choose a clean installation or force a restart. Back up your files before upgrading." Foreground="#74808D"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Registry queue" Margin="7,3,0,12"/><Border Grid.Row="1" Background="#FAFAFA" CornerRadius="6" Padding="20"><StackPanel><TextBlock Text="Registry" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Planned" Foreground="#9A7023" Margin="0,10"/><TextBlock Text="Importing registry files and editing image hives are planned. This preview does not modify registry settings." Foreground="#777777" MaxWidth="520" HorizontalAlignment="Left"/></StackPanel></Border></Grid></TabItem>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Post-Setup tasks" Margin="7,3,0,12"/><Border Grid.Row="1" Background="#FAFAFA" CornerRadius="6" Padding="20"><StackPanel><TextBlock Text="Post-Setup" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Planned" Foreground="#9A7023" Margin="0,10"/><TextBlock Text="Command, file and directory tasks after Windows Setup are planned. No post-setup tasks are written by this preview." Foreground="#777777" MaxWidth="520" HorizontalAlignment="Left"/></StackPanel></Border></Grid></TabItem>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Components" Margin="7,3,0,12"/><Border Grid.Row="1" Background="#FAFAFA" CornerRadius="6" Padding="20"><StackPanel><TextBlock Text="Components" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Planned" Foreground="#9A7023" Margin="0,10"/><TextBlock Text="Component removal and compatibility protection are planned. Use Features for supported optional-feature changes." Foreground="#777777" MaxWidth="520" HorizontalAlignment="Left"/></StackPanel></Border></Grid></TabItem>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Settings" Margin="7,3,0,12"/><Border Grid.Row="1" Background="#FAFAFA" CornerRadius="6" Padding="20"><StackPanel><TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Planned" Foreground="#9A7023" Margin="0,10"/><TextBlock Text="Windows customization settings are planned. No settings are changed from this page." Foreground="#777777" MaxWidth="520" HorizontalAlignment="Left"/></StackPanel></Border></Grid></TabItem>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Scheduled Tasks" Margin="7,3,0,12"/><Border Grid.Row="1" Background="#FAFAFA" CornerRadius="6" Padding="20"><StackPanel><TextBlock Text="Scheduled Tasks" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Planned" Foreground="#9A7023" Margin="0,10"/><TextBlock Text="Inspecting and configuring Windows scheduled tasks are planned. No tasks are changed from this page." Foreground="#777777" MaxWidth="520" HorizontalAlignment="Left"/></StackPanel></Border></Grid></TabItem>
   </TabControl>
   <Border x:Name="PresetPane" Grid.Column="2" Background="#FAFAFA" CornerRadius="6" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Top"><WrapPanel><TextBlock Text="Presets" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Click="LoadPreset_Click" ToolTip="Import an ImageForge JSON preset"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="File"/></StackPanel></Button><Button Click="SavePreset_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Foreground="#218AA5" Margin="0,0,6,0"/><TextBlock Text="Save"/></StackPanel></Button></WrapPanel><TextBox x:Name="PresetFilterBox" TextChanged="PresetFilter_Changed" ToolTip="Filter presets by name" Padding="5,4" Margin="0,5,0,7"/><DockPanel Margin="4,0,4,7"><TextBlock DockPanel.Dock="Right" Text="Last change" Foreground="#999999" FontSize="10"/><TextBlock Text="Name" Foreground="#999999" FontSize="10"/></DockPanel></StackPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="Load selected preset" Click="LoadSelectedPreset_Click" Margin="0,8,0,3"/><TextBlock Text="Presets never apply changes automatically." FontSize="10" Foreground="#999999"/></StackPanel><ListBox x:Name="PresetList" MouseDoubleClick="Preset_DoubleClick" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,4" ToolTip="{Binding Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Modified}" Foreground="#999999" FontSize="10" TextWrapping="NoWrap" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#E1E6EB" BorderThickness="0,1,0,0" Padding="10,4"><DockPanel><TextBlock x:Name="FooterTarget" DockPanel.Dock="Right" Foreground="#777777" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0"/><Button x:Name="CancelDownloadButton" DockPanel.Dock="Right" Content="Cancel download" Visibility="Collapsed" Click="CancelDownload_Click" Padding="10,3" Margin="10,0,0,0"/><ProgressBar x:Name="BusyProgress" DockPanel.Dock="Right" Width="150" Height="13" Margin="14,0,0,0" Visibility="Collapsed" IsIndeterminate="True"/><TextBlock x:Name="StatusText" Text="Ready · Add an image to begin" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="#62707B" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>

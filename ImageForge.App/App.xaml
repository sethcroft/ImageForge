<Application x:Class="ImageForge.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#10151D" />
    <SolidColorBrush x:Key="PanelBrush" Color="#19212D" />
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource CanvasBrush}"/><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="Background" Value="#2A384A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="#F4F7FC"/><Setter Property="BorderBrush" Value="#3D4B60"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,6,0,14"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,6,0,14"/><Setter Property="Foreground" Value="#10151D"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="Background" Value="#263448"/><Setter Property="Padding" Value="18,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#12674F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListView"><Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="Margin" Value="0,8,0,14"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/></Style>
    <Style TargetType="ListViewItem"><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#243246"/><Setter Property="Foreground" Value="#CED9E9"/><Setter Property="Padding" Value="8"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#9CAEC5"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  </Application.Resources>
</Application>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ImageForge</AssemblyName>
    <Version>0.5.0-preview.1</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../ImageForge.Core/ImageForge.Core.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../LICENSE" LogicalName="ImageForge.LICENSE" /></ItemGroup>
</Project>
